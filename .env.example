# Dinner for You · 环境变量参考模板
# ──────────────────────────────────────────────────────────────
# 复制为 .env 仅供本地对照；敏感项（标 ✅ secret）一律用
#   wrangler pages secret put <NAME>
# 写入，切勿把真实值提交进仓库。
# 本文件只列「变量名 + 缺省值」，不含任何真实凭证。
# ──────────────────────────────────────────────────────────────

# ── 必填（secret）──
ADMIN_PASSWORD=                # ✅ 后台登录密码（自己设）
RESEND_API_KEY=                # ✅ Resend API Key
OWNER_EMAIL=                   # ✅ 新订单邮件接收地址
SITE_URL=https://dinner.example.xyz   # ✅ 你的域名（拼邮件深链用）
GC_KEY=                        # ✅ 长随机串，外部定时器调 /api/gc?key= 用

# ── 可选（非敏感，可放 [vars] 或 secret）──
MAIL_FROM=Dinner <noreply@example.xyz>
RETENTION_DAYS=3
ORDER_RETENTION_DAYS=30
TZ_OFFSET=8
MAX_PHOTOS=3
MAX_PHOTO_BYTES=307200
MAX_SONG_BYTES=2097152
DAILY_LIMIT=5
PENDING_LIMIT=3

# ── 换皮（白牌化，不改代码）──
# BRAND_JSON={"name":"Dinner for You","nameZh":"今晚吃什么","tagline":"点你想吃的，唱一首给我听","chef":"厨师","guest":"","footer":"这是一间只有两个人的厨房"}
# MENU_JSON=[{"cat":"主菜","items":[{"id":"hongshaorou","name":"红烧肉","desc":"小火慢炖","mins":70}]}]

# ── 可选通知 ──
# TG_BOT_TOKEN=
# TG_CHAT_ID=

# ── 仅当没绑 D1 binding 时填（正常绑定后不用）──
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# D1_DATABASE_ID=
